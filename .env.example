# One OpenRouter key covers Jev and every LLM provider.
OPENROUTER_API_KEY=

# Jev via OpenRouter. For TypeSafe direct (early access), unset this and set TYPESAFE_API_KEY.
TYPESAFE_BASE_URL=https://openrouter.ai/api
# TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# LLM: any OpenAI-compatible endpoint (OpenRouter by default).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# off | minimal | low | medium | high  (some models, e.g. Gemini Flash, can't turn it off)
LLM_REASONING=low

MAX_STEPS=8
HYBRID_THRESHOLD=0.5

# Phoenix: local `uv run phoenix serve` (default http://localhost:6006) or Phoenix Cloud.
PHOENIX_PROJECT_NAME=jev-research-agent
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<space>
# PHOENIX_API_KEY=
