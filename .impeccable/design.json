  "narrative": {
    "northStar": "Conference proceedings",
    "overview": "Conference proceedings translated into a presentation reader: large editorial titles, an open paper surface, a numbered chapter index, and a restrained interactive routing diagram. This description records the implemented visual world; it is not a claim of user-approved qualitative preferences.\n\nThe hierarchy gives the question prominence while keeping mechanisms, planned comparisons, and supplied evidence readable. Pending content has its own explicit visual state rather than simulated findings.",
    "keyCharacteristics": [
      "Paper surfaces and hairline rules.",
      "Serif research titles with sans-serif explanations and controls.",
      "Forest decision surfaces and lime selected actions.",
      "Explicit pending, loaded, and error states."
    ],
    "rules": [
      {
        "name": "Decision Accent",
        "body": "Use the forest-and-lime pairing for the decision node and selected routing actions; keep reading surfaces on paper.",
        "section": "colors"
      },
      {
        "name": "Editorial Hierarchy",
        "body": "Use Instrument Serif for research titles and selected section headings; use DM Sans for explanatory text, navigation, and controls.",
        "section": "typography"
      },
      {
        "name": "Flat Reading Surface",
        "body": "Separate content with spacing, hairline rules, and tonal fills; the implementation uses no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the paper, ink, forest, and lime roles defined by the frontmatter.",
      "Do keep chapter navigation, current position, and previous/next controls clear.",
      "Do distinguish pending evidence from supplied findings using explicit status text.",
      "Do retain visible keyboard focus and respect reduced-motion preferences.",
      "Do let the mobile chapter index scroll horizontally while page content remains within the viewport."
    ],
    "donts": [
      "Don't add invented result values or treat the empty-chart illustration as measured data.",
      "Don't repeat the current chapter name as an eyebrow above its title.",
      "Don't replace the open, rule-separated composition with a generic shadowed-card grid.",
      "Don't infer additional approved aesthetic preferences from this observed implementation."
    ]
  }
}
